# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL Cloud Integration
# Obtain from Supabase Project Settings -> API (Project URL and anon/public key)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Turso Cloud Database Integration (LibSQL / Serverless SQLite)
# Obtain from Turso CLI (`turso db show <db-name> --url` and `turso db tokens create <db-name>`) or Turso Dashboard (https://app.turso.tech)
# Backend / Server / Vercel API:
TURSO_DATABASE_URL=libsql://your-new-database-name-username.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# Frontend / Vite Client-Side (Optional for direct browser-to-Turso connection):
VITE_TURSO_DATABASE_URL=https://your-new-database-name-username.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

